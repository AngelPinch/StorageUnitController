sort
  Position = struct pos(x: Nat, y: Nat);
  Item     = struct none | item(n: Nat);

act
  tick, ticks;

  move: Position;
  pick, place: Item;

  backup, store_backup, bk: Position # Item # Nat;

proc
  Storage =
    sum p: Position, it: Item, v: Nat .
      (x(p) < 3 && y(p) < 3 &&
       (it == none || it == item(1)) &&
       v < 4)
      -> store_backup(p, it, v) . Storage;

  Controller(p: Position, cur: Item, dbv: Nat, t: Nat) =
      (t < 2) ->
        tick .
        Controller(p, cur, dbv, t + 1)

    + (t == 2) ->
        backup(p, cur, dbv) .
        Controller(p, cur, (dbv + 1) mod 4, 0)

    + (sum nx, ny: Nat .
        (nx < 3 && ny < 3 &&
         ((nx == x(p) + 1 && ny == y(p)) ||
          (x(p) == nx + 1 && ny == y(p)) ||
          (ny == y(p) + 1 && nx == x(p)) ||
          (y(p) == ny + 1 && nx == x(p))))
        -> move(pos(nx, ny)) .
           Controller(pos(nx, ny), cur, dbv, t))

    + ((cur == none) ->
        pick(item(1)) .
        Controller(p, item(1), dbv, t))

    + ((cur != none) ->
        place(cur) .
        Controller(p, none, dbv, t));

init
  allow({ticks, move, pick, place, bk},
    comm({tick | tick -> ticks,
          backup | store_backup -> bk},
      Controller(pos(0, 0), none, 0, 0)
      || Storage));